# Database and authentication
DATABASE_URL="file:./dev.db"
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
SETTINGS_ENCRYPTION_KEY=""

# Optional fallback. After first login, these can be configured in Admin > Site Settings.
# Image provider: openai, async, or apimart (legacy compatibility)
IMAGE_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ASYNC_API_KEY=""
ASYNC_BASE_URL=""
# Legacy APIMart fallback only; new integrations should use Admin > Site Settings.
APIMART_API_KEY=""
APIMART_BASE_URL="https://api.apimart.ai/v1"
APIMART_MODEL="gpt-image-2"

# Email verification, password reset, and optional operations alerts.
# Use smtp for any SMTP-compatible service, or resend for Resend's HTTP API.
# If EMAIL_PROVIDER is empty, SMTP_HOST takes priority, then RESEND_API_KEY.
EMAIL_PROVIDER=""
EMAIL_FROM="AI Image Starter <noreply@your-domain.com>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
RESEND_API_KEY=""

# Optional moderation and operations
FORBIDDEN_PROMPT_TERMS=""
NEXT_PUBLIC_FORBIDDEN_PROMPT_TERMS=""
DATABASE_WATCHDOG_ENABLED="true"
OPS_ALERT_EMAIL=""

# Set these yourself before `npm run seed`; there are no default login credentials.
# After the first admin is created, remove ADMIN_PASSWORD from your local .env.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_INITIAL_CREDITS="1000"
